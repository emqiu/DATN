@model IEnumerable<Data.EF.Color>
@{
    ViewBag.Title = "Quản lý màu sắc";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
@section header {
    Quản lý color của sản phẩm
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Danh sách color của sản phẩm</h6>
    </div>
    <div class="card-body">
        @using (Html.BeginForm("Index", "Color", FormMethod.Get))
        {
            <div class="row form-group">
                <div class="col-lg-12 row">
                    <div class="col-md-4">
                        <a href="/Admin/Color/Create" class="btn btn-primary">Thêm mới</a>
                    </div>
                </div>
            </div>
        }
        <div class="table-responsive" style="overflow-x: hidden;">
            <div id="dataTable_wrapper" class="dataTables_wrapper dt-bootstrap4">
                <div class="row">
                    <div class="col-sm-12">
                        <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Tên</th>
                                    <th>Mã màu</th>
                                    <th>Hiển thị</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr id="row_@item.Id">
                                        <td>@item.Name</td>
                                        <td>@item.CodeColor</td>
                                        <td>
                                            <span style="display:inline-block;width:32px;height:32px;background:@item.CodeColor;border:1px solid #ccc;"></span>
                                        </td>

                                        <td>
                                            <a href="@Url.Action("Edit", "Color", new { id = item.Id })" class="btn text-primary f2"><i class="fas fa-edit"></i></a>
                                            @Ajax.ActionLink(" ", "Delete", new { @id = item.Id }, new AjaxOptions
                                            {
                                                Confirm = "Bạn có muốn xóa bản ghi này?",
                                                OnComplete = "$('#row_" + @item.Id + "').remove()",
                                                HttpMethod = "Delete"
                                            }, new { @class = "btn text-primary f1 myActionLink" })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section CustomJs {
    <script>
        $('.myActionLink').prepend("<i class='fa-solid fa-trash-can'></i> ");
    </script>
}